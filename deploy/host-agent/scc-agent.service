[Unit]
Description=Server Control Center Host Monitor Agent
After=local-fs.target docker.service
Wants=docker.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/scc-agent/agent.py
Restart=on-failure
RestartSec=3
RuntimeDirectory=scc-agent
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=restart
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
UMask=0007

[Install]
WantedBy=multi-user.target
