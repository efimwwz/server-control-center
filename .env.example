# Server Control Center image version (without the leading v)
SCC_VERSION=1.1.1

# Keep the metrics provider set to the host agent for production installs.
METRICS_PROVIDER=agent

# Set to 1 only when a trusted reverse proxy is the sole route to the app.
TRUST_PROXY=0

# Optional: enables AI analysis. Telemetry and selected logs are sent to Google Gemini.
GEMINI_API_KEY=
