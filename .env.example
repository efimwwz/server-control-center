# Port for Express server and Vite in development
PORT=3000

# Environment mode: 'development' or 'production'
NODE_ENV=production

# Metrics provider mode: 'mock' (default for safe isolated preview) or 'linux' (for live VPS monitoring)
METRICS_PROVIDER=mock

# Gemini AI API Key for VPS diagnostics assistant
# AI Studio automatically injects this at runtime from user secrets.
# If omitted, intelligent contextual server diagnostic engine is used automatically.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"
